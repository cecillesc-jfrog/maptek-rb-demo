// USE CASE: "Find all release builds for project maptek-geo-suite since October 2025"
//
// Combines a property filter (build.type=release) with an Artifactory
// date filter (created >= ISO date).  Returns one manifest.json per
// service per release — sort descending so newest appears first.
//
// Run via:  POST https://hts1.jfrog.io/artifactory/api/search/aql

items.find({
  "@project.name": {"$eq": "maptek-geo-suite"},
  "@build.type":   {"$eq": "release"},
  "repo":          {"$match": "maptek-docker-local"},
  "created":       {"$gte": "2025-10-01T00:00:00.000Z"}
}).include(
  "name", "repo", "path", "created", "property"
).sort({"$desc": ["created"]})


// ── Variant: all build types (release + snapshot + hotfix), newest 50 ────────
