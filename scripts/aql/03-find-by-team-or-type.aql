// USE CASE: Filter artifacts by component team or service type
//
// Per-artifact properties include component.team and component.service_type,
// allowing operations teams to query their own slice of any release.
//
// Run via:  POST https://hts1.jfrog.io/artifactory/api/search/aql

// ── Platform team artifacts (geo-api + auth-service) ─────────────────────────
items.find({
  "@project.name":   {"$eq": "maptek-geo-suite"},
  "@component.team": {"$eq": "platform"},
  "repo":            {"$match": "maptek-docker-local"}
}).include(
  "name", "repo", "path", "created", "property"
).sort({"$asc": ["path"]})


