// USE CASE: Query Release Bundles by their collective (bundle-level) metadata
//
// The rb.* properties are set on the bundle itself via --prop in jf rbc.
// These are distinct from per-artifact properties — they describe the
// bundle as a whole (e.g. all components included, pipeline origin).
//
// Run via:  POST https://hts1.jfrog.io/artifactory/api/search/aql

// ── Find all release bundles for the project ─────────────────────────────────
release_bundles.find({
  "@rb.project":    {"$eq": "maptek-geo-suite"},
  "@rb.build_type": {"$eq": "release"}
}).include(
  "name", "version", "created", "status", "properties"
).sort({"$desc": ["created"]})


